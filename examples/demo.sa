# quantum-equations demo — from simple to complex
#
#   bundle:  qrun <quantum-bundle>/bin/bundle.sa     (builds build/demo.sa, see package.json)
#   run:     qrun build/demo.sa

# @use ../index.sa

fn title(text) {
    print("")
    print("== " + text + " ==")
}

fn rootsText(result) {
    let parts = []
    for r in result["roots"] { parts.push(Num.fmt(r, 8)) }
    for z in result["complex"] { parts.push(Complex.show(z, 6)) }
    return parts.join(",  ")
}

# ── 1. simple arithmetic and one-line formulas ──────────────────────────
title("Formulas as text")
print("3 + 4 * 2          =", Eq.evaluate("3 + 4 * 2"))
print("2^3^2              =", Eq.evaluate("2^3^2"))
print("2pi r, r = 5       =", Num.fmt(Eq.evaluate("2pi r", {"r": 5}), 6))
print("sqrt(2)^2          =", Num.fmt(Eq.evaluate("sqrt(2)^2"), 12))
print("5!                 =", Eq.evaluate("5!"))
print("gamma(0.5)^2       =", Num.fmt(Eq.evaluate("gamma(0.5)^2"), 10), " (that is pi)")

# ── 2. linear and quadratic equations ───────────────────────────────────
title("Linear and quadratic")
print("2x + 6 = 0                 x =", rootsText(Eq.solve("2x + 6 = 0")))
print("3(x - 2) = x + 4           x =", rootsText(Eq.solve("3(x - 2) = x + 4")))
print("x^2 - 5x + 6 = 0           x =", rootsText(Eq.solve("x^2 - 5x + 6 = 0")))
print("x^2 + 2x + 5 = 0           x =", rootsText(Eq.solve("x^2 + 2x + 5 = 0")))
print("a x^2 + b x + c, a=1 b=-3 c=2   x =", rootsText(Eq.solve("a x^2 + b x + c = 0", "x", {"a": 1, "b": -3, "c": 2})))
let v = Solve.vertex(1, -4, 7)
print("vertex of x^2 - 4x + 7:", "(" + Num.fmt(v["x"]) + ", " + Num.fmt(v["y"]) + ")")

# ── 3. higher-degree polynomials ────────────────────────────────────────
title("Polynomials of any degree")
print("x^3 - 6x^2 + 11x - 6 = 0   x =", rootsText(Eq.solve("x^3 - 6x^2 + 11x - 6 = 0")))
print("x^4 - 5x^2 + 4 = 0         x =", rootsText(Eq.solve("x^4 - 5x^2 + 4 = 0")))
let rep = Eq.solve("(x - 2)^3 (x + 1) = 0")
print("(x - 2)^3 (x + 1) = 0      x =", rootsText(rep), "  multiplicities", rep["multiplicities"])
print("x^5 - 1 = 0                x =", rootsText(Eq.solve("x^5 - 1 = 0")))
print("expand (x+1)^4             =", Eq.expand("(x + 1)^4"))
print("cubic by formula:", Solve.cubic(2, -12, 22, -12).map(fn(r) { return Num.fmt(r, 8) }))

# ── 4. equations with no closed form ────────────────────────────────────
title("Transcendental equations (numeric)")
print("cos(x) = x                 x =", rootsText(Eq.solve("cos(x) = x")))
print("exp(x) = 5                 x =", rootsText(Eq.solve("exp(x) = 5")))
print("sin(x) = 0.5 on [0, 7]     x =", rootsText(Eq.solve("sin(x) = 0.5", "x", {}, {"range": [0, 7]})))
print("x ln(x) = 3  on (0.1, 10)  x =", rootsText(Eq.solve("x ln(x) = 3", "x", {}, {"range": [0.1, 10]})))
print("x^x = 10                   x =", rootsText(Eq.solve("x^x = 10", "x", {}, {"range": [0.5, 5]})))

# ── 5. systems ──────────────────────────────────────────────────────────
title("Systems of equations")
let sys1 = Eq.solveSystem(["x + y = 3", "x - y = 1"], ["x", "y"])
print("x + y = 3, x - y = 1       ", sys1["solution"])
let sys2 = Eq.solveSystem(["2x + 3y - z = 5", "x - y + 2z = 1", "3x + y + z = 8"], ["x", "y", "z"])
print("3 x 3 linear               ", sys2["solution"])
print("x + y = 1, x + y = 2       ", Eq.solveSystem(["x + y = 1", "x + y = 2"], ["x", "y"])["type"])
let sys3 = Eq.solveSystem(["x^2 + y^2 = 25", "y = x + 1"], ["x", "y"])
print("circle meets line          ", sys3["solutions"])
print("exact (fractions)          ", Frac.showAll(Frac.solveSystem([[2, 1], [1, 3]], [3, 5])))

# ── 6. calculus ─────────────────────────────────────────────────────────
title("Calculus")
print("d/dx x^2 sin(x)           =", Eq.derivative("x^2 * sin(x)", "x"))
print("d/dx ln(3x) + exp(2x)     =", Eq.derivative("ln(3x) + exp(2x)", "x"))
print("d2/dx2 x^4                =", Eq.derivative("x^4", "x", 2))
print("integral sin(x), 0..pi    =", Num.fmt(Eq.integral("sin(x)", "x", 0, PI), 10))
print("integral exp(-x^2), -inf..inf =", Num.fmt(Eq.integral("exp(-x^2)", "x", -INF, INF), 10), "(sqrt(pi) =", Num.fmt(sqrt(PI), 10) + ")")
print("limit sin(x)/x at 0       =", Num.fmt(Eq.limit("sin(x)/x", "x", 0), 6))
print("Taylor of cos(x)          =", Eq.taylor("cos(x)", "x", 0, 6)["text"])
let ode = Calc.solveIVP(fn(t, y) { return y * (1 - y) }, 0, 0.1, 5)
print("logistic y' = y(1-y), y(0)=0.1, y(5) =", Num.fmt(ode, 8))
let osc = Calc.solveIVP(fn(t, s) { return [s[1], -s[0]] }, 0, [1, 0], PI)
print("oscillator at t = pi       ", osc.map(fn(x) { return Num.fmt(x, 6) }))

# ── 7. linear algebra and exact arithmetic ──────────────────────────────
title("Matrices, fractions, integers")
let m = [[4, 1, 0], [1, 3, 1], [0, 1, 2]]
print("det =", Num.fmt(LinAlg.det(m), 6), "  rank =", LinAlg.rank(m))
print("eigenvalues:", LinAlg.eigenvalues(m).map(fn(z) { return Complex.show(z, 5) }))
print("fit a parabola through noisy points:", Poly.show(Poly.fit([0, 1, 2, 3, 4], [1.1, 1.9, 5.2, 9.8, 17.1], 2), "x", 4))
print("1/3 + 1/6 =", Frac.show(Frac.add(Frac.make(1, 3), Frac.make(1, 6))))
print("3x + 5y = 22, whole numbers:", NumTheory.smallestPositiveDiophantine(3, 5, 22))
print("x = 2 (mod 3), 3 (mod 5), 2 (mod 7):", NumTheory.crt([2, 3, 2], [3, 5, 7]))
print("Pell x^2 - 61y^2 = 1:", NumTheory.pell(61))
print("(1+2i)(3-i) =", Complex.show(Complex.mul(Complex.make(1, 2), Complex.make(3, -1))))
