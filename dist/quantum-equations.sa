    fn asinh(x) { return log(x + sqrt(x * x + 1)) }
    fn acosh(x) { return log(x + sqrt(x * x - 1)) }
    fn atanh(x) { return 0.5 * log((1 + x) / (1 - x)) }

    fn degToRad(d) { return d * PI / 180 }
    fn radToDeg(r) { return r * 180 / PI }

    # ── special functions ────────────────────────────────────────────────

    # Gamma function (Lanczos approximation, ~15 digits). gamma(n) = (n-1)!
    fn gamma(x) {
        if x == floor(x) and x <= 0 { return INF }
        if x < 0.5 {
            return PI / (sin(PI * x) * self.gamma(1 - x))
        }
        x = x - 1
        let a = self.LANCZOS[0]
        let t = x + 7.5
        for i in range(1, 9) {
            a = a + self.LANCZOS[i] / (x + i)
        }
        return sqrt(2 * PI) * pow(t, x + 0.5) * self.exp(-t) * a
    }

    # n! — exact for whole numbers up to 170, gamma(n+1) otherwise.
    fn factorial(n) {
        if n < 0 { raise "factorial of a negative number" }
        if n == floor(n) {
            if n > 170 { return INF }
            let r = 1
            for i in range(2, n + 1) { r = r * i }
            return r
        }
        return self.gamma(n + 1)
    }

    # Binomial coefficient, exact while the result fits a double.
    fn binomial(n, k) {
        if k < 0 or k > n { return 0 }
        if k > n - k { k = n - k }
        let r = 1
        for i in range(1, k + 1) {
            r = r * (n - k + i) / i
        }
        return round(r)
    }

    # Error function. Series erf(x) = 2/sqrt(pi) * exp(-x^2) * sum 2^n x^(2n+1) / (2n+1)!!
    fn erf(x) {
        if x < 0 { return -self.erf(-x) }
        if x > 6 { return 1 }
        let term = x
        let total = x
        let n = 0
        while abs(term) > 1e-17 * abs(total) and n < 300 {
            n = n + 1
            term = term * 2 * x * x / (2 * n + 1)
            total = total + term
        }
        return 2 / sqrt(PI) * self.exp(-x * x) * total
