        if imText == "1" { imText = "" }
        imText = imText + "i"
        if re == 0 {
            if im < 0 { return "-" + imText }
            return imText
        }
        let joiner = im < 0 ? " - " : " + "
        return Num.fmt(re, digits) + joiner + imText
    }

    # A plain number when the value is (numerically) real, else a cleaned complex.
    fn simplify(a, eps) {
        a = self.of(a)
        if self.isReal(a, eps) { return Num.clean(a["re"]) }
        return {"re": Num.clean(a["re"]), "im": Num.clean(a["im"])}
    }
}

