# @use quantum-test
# @use ../src/core.sa
# @use ../src/complex.sa
# @use ../src/linalg.sa
# @use ../src/poly.sa

describe("LinAlg", fn() {
    it("builds and multiplies matrices", fn() {
        expect(LinAlg.identity(2)).toEqual([[1, 0], [0, 1]])
        expect(LinAlg.transpose([[1, 2, 3], [4, 5, 6]])).toEqual([[1, 4], [2, 5], [3, 6]])
        expect(LinAlg.multiply([[1, 2], [3, 4]], [[5, 6], [7, 8]])).toEqual([[19, 22], [43, 50]])
        expect(LinAlg.mulVec([[1, 2], [3, 4]], [1, 1])).toEqual([3, 7])
        expect(LinAlg.power([[1, 1], [1, 0]], 10)[0][1]).toBe(55)
        expect(LinAlg.trace([[1, 2], [3, 4]])).toBe(5)
    })
    it("does vector math", fn() {
        expect(LinAlg.dot([1, 2, 3], [4, 5, 6])).toBe(32)
        expect(LinAlg.norm([3, 4])).toBe(5)
        expect(LinAlg.cross([1, 0, 0], [0, 1, 0])).toEqual([0, 0, 1])
    })
    it("computes determinants and inverses", fn() {
        expect(LinAlg.det([[1, 2], [3, 4]])).toBeCloseTo(-2)
        expect(LinAlg.det([[2, 0, 0], [0, 3, 0], [0, 0, 4]])).toBeCloseTo(24)
        expect(LinAlg.det([[1, 2], [2, 4]])).toBe(0)
        expect(LinAlg.det([[0, 1], [1, 0]])).toBeCloseTo(-1)
        let inv = LinAlg.inverse([[4, 7], [2, 6]])
        expect(inv[0][0]).toBeCloseTo(0.6)
        expect(inv[0][1]).toBeCloseTo(-0.7)
        expect(inv[1][0]).toBeCloseTo(-0.2)
        expect(inv[1][1]).toBeCloseTo(0.4)
        expect(fn() { LinAlg.inverse([[1, 2], [2, 4]]) }).toThrow()
    })
    it("solves square systems", fn() {
        let x = LinAlg.solve([[2, 1], [1, 3]], [3, 5])
        expect(x[0]).toBeCloseTo(0.8)
        expect(x[1]).toBeCloseTo(1.4)
        let y = LinAlg.solve([[0, 2, 1], [1, 1, 1], [2, 1, 0]], [7, 6, 4])
        expect(y[0]).toBeCloseTo(1)
        expect(y[1]).toBeCloseTo(2)
        expect(y[2]).toBeCloseTo(3)
        expect(fn() { LinAlg.solve([[1, 2], [2, 4]], [1, 2]) }).toThrow()
    })
    it("classifies systems and finds rank", fn() {
        expect(LinAlg.rank([[1, 2], [2, 4]])).toBe(1)
        expect(LinAlg.rank([[1, 0, 0], [0, 1, 0], [0, 0, 1]])).toBe(3)
        expect(LinAlg.analyze([[1, 1], [1, -1]], [3, 1])["type"]).toBe("unique")
        expect(LinAlg.analyze([[1, 1], [1, 1]], [3, 4])["type"]).toBe("none")
        let inf = LinAlg.analyze([[1, 1], [2, 2]], [2, 4])
        expect(inf["type"]).toBe("infinite")
        expect(inf["free"]).toEqual([1])
        expect(inf["particular"]).toEqual([2, 0])
    })
    it("fits least squares", fn() {
        let x = LinAlg.leastSquares([[1, 1], [1, 2], [1, 3]], [1, 2, 2])
        expect(x[0]).toBeCloseTo(0.6666666667, 8)
        expect(x[1]).toBeCloseTo(0.5, 8)
    })
    it("finds eigenvalues", fn() {
        let e = LinAlg.eigen2([[2, 0], [0, 3]])
        expect(e[0]["re"]).toBe(3)
        expect(e[1]["re"]).toBe(2)
        let rot = LinAlg.eigen2([[0, -1], [1, 0]])
        expect(Complex.show(rot[0])).toBe("i")
        let p = LinAlg.powerIteration([[2, 1], [1, 2]])
        expect(p["value"]).toBeCloseTo(3, 8)
        let s = LinAlg.eigenSymmetric([[2, 1], [1, 2]])
        expect(s["values"][0]).toBeCloseTo(3, 9)
        expect(s["values"][1]).toBeCloseTo(1, 9)
        let cp = LinAlg.charPoly([[2, 1], [1, 2]])
        expect(cp[1]).toBeCloseTo(-4)
        expect(cp[2]).toBeCloseTo(3)
        let ev = LinAlg.eigenvalues([[4, 1, 0], [1, 3, 1], [0, 1, 2]])
        expect(len(ev)).toBe(3)
        expect(Complex.abs(ev[0]) + Complex.abs(ev[1]) + Complex.abs(ev[2])).toBeGreaterThan(8)
    })
})

describe("Poly", fn() {
    it("evaluates and shows", fn() {
        expect(Poly.evaluate([1, -3, 2], 5)).toBe(12)
        expect(Poly.show([1, -3, 2])).toBe("x^2 - 3x + 2")
        expect(Poly.show([-1, 0, 4])).toBe("-x^2 + 4")
        expect(Poly.show([2, 0, 0, -0.5], "t")).toBe("2t^3 - 0.5")
        expect(Poly.show([0])).toBe("0")
        expect(Poly.degree([0, 0, 3, 1])).toBe(1)
    })
    it("does algebra", fn() {
        expect(Poly.add([1, 2, 3], [4, 5])).toEqual([1, 6, 8])
        expect(Poly.sub([1, 2, 3], [1, 2, 3])).toEqual([0])
        expect(Poly.mul([1, 1], [1, -1])).toEqual([1, 0, -1])
        expect(Poly.pow([1, 1], 3)).toEqual([1, 3, 3, 1])
        expect(Poly.compose([1, 0, 1], [1, 1])).toEqual([1, 2, 2])
        let d = Poly.divide([1, 0, -1], [1, 1])
        expect(d["quotient"]).toEqual([1, -1])
        expect(d["remainder"]).toEqual([0])
        let d2 = Poly.divide([1, 0, 0, 1], [1, 1])
        expect(d2["quotient"]).toEqual([1, -1, 1])
    })
    it("differentiates and integrates", fn() {
        expect(Poly.derivative([1, -3, 2])).toEqual([2, -3])
        expect(Poly.derivative([5])).toEqual([0])
        expect(Poly.integral([3, 2, 1], 7)).toEqual([1, 1, 1, 7])
        expect(Poly.integrate([2, 0], 0, 3)).toBe(9)
    })
    it("finds roots", fn() {
        let r = Poly.realRoots([1, -6, 11, -6])
        expect(r[0]).toBeCloseTo(1, 8)
        expect(r[1]).toBeCloseTo(2, 8)
        expect(r[2]).toBeCloseTo(3, 8)
        let q = Poly.roots([1, 0, 1])
        expect(Complex.show(q[0])).toBe("-i")
        expect(Complex.show(q[1])).toBe("i")
        expect(Poly.realRoots([1, 0, 1])).toEqual([])
        let z = Poly.realRoots([1, 0, 0, 0])
        expect(len(z)).toBe(3)
        let quartic = Poly.realRoots([1, -10, 35, -50, 24])
        expect(quartic[0]).toBeCloseTo(1, 7)
        expect(quartic[3]).toBeCloseTo(4, 7)
        let withZero = Poly.realRoots([1, -3, 2, 0])
        expect(withZero[0]).toBeCloseTo(0, 9)
        expect(withZero[2]).toBeCloseTo(2, 9)
        let big = Poly.roots([1, 0, 0, 0, 0, -1])
        expect(len(big)).toBe(5)
    })
    it("rebuilds polynomials from roots", fn() {
        expect(Poly.fromRoots([1, 2, 3])).toEqual([1, -6, 11, -6])
        expect(Poly.fromRoots([Complex.make(0, 1), Complex.make(0, -1)])).toEqual([1, 0, 1])
    })
    it("interpolates and fits", fn() {
        let p = Poly.interpolate([0, 1, 2], [1, 3, 7])
        expect(p[0]).toBeCloseTo(1)
        expect(p[1]).toBeCloseTo(1)
        expect(p[2]).toBeCloseTo(1)
        let f = Poly.fit([0, 1, 2, 3], [1, 3, 7, 13], 2)
        expect(f[0]).toBeCloseTo(1, 8)
        expect(f[1]).toBeCloseTo(1, 8)
        expect(f[2]).toBeCloseTo(1, 8)
    })
})

Test.report()
