# @use quantum-test
# @use ../src/eq.sa

describe("Eq polynomial equations", fn() {
    it("solves linear and quadratic equations in text", fn() {
        expect(Eq.solve("2x + 6 = 0")["roots"]).toEqual([-3])
        expect(Eq.solve("3(x - 2) = x + 4")["roots"]).toEqual([5])
        let q = Eq.solve("x^2 - 5x + 6 = 0")
        expect(q["method"]).toBe("polynomial")
        expect(q["degree"]).toBe(2)
        expect(q["roots"][0]).toBeCloseTo(2, 12)
        expect(q["roots"][1]).toBeCloseTo(3, 12)
        let r = Eq.solve("x^2 = 2")
        expect(r["roots"][0]).toBeCloseTo(-sqrt(2), 12)
        expect(r["roots"][1]).toBeCloseTo(sqrt(2), 12)
        expect(Eq.solve("x^2 + 1 = 0")["roots"]).toEqual([])
        expect(len(Eq.solve("x^2 + 1")["complex"])).toBe(2)
        expect(Eq.solve("x^2 + 1 = 0")["complex"][1]).toEqual({"re": 0, "im": 1})
    })
    it("solves higher degrees with multiplicity", fn() {
        let c = Eq.solve("x^3 - 6x^2 + 11x - 6 = 0")
        expect(c["roots"][0]).toBeCloseTo(1, 9)
        expect(c["roots"][2]).toBeCloseTo(3, 9)
        let d = Eq.solve("(x - 1)^2 = 0")
        expect(d["roots"]).toEqual([1])
        expect(d["multiplicities"]).toEqual([2])
        let t = Eq.solve("(x - 2)^3 = 0")
        expect(t["roots"][0]).toBeCloseTo(2, 11)
        expect(t["multiplicities"]).toEqual([3])
        let m = Eq.solve("x^2 (x - 1) = 0")
        expect(m["roots"]).toEqual([0, 1])
        expect(m["multiplicities"]).toEqual([2, 1])
        let q = Eq.solve("x^4 - 5x^2 + 4 = 0")
        expect(len(q["roots"])).toBe(4)
        expect(q["roots"][3]).toBeCloseTo(2, 9)
        let mixed = Eq.solve("x^5 - 1 = 0")
        expect(mixed["roots"]).toEqual([1])
        expect(len(mixed["complex"])).toBe(4)
        let rational = Eq.solve("(x^2 - 4) / 2 = 0")
        expect(rational["roots"][0]).toBeCloseTo(-2, 12)
    })
    it("handles identities, contradictions and parameters", fn() {
        expect(Eq.solve("x + 1 = x + 1", "x")["identity"]).toBeTruthy()
        let none = Eq.solve("x + 1 = x + 2", "x")
        expect(none["identity"]).toBeFalsy()
        expect(none["roots"]).toEqual([])
        let p = Eq.solve("a x + b = 0", "x", {"a": 2, "b": -6})
        expect(p["roots"]).toEqual([3])
        let g = Eq.solve("a x^2 + b x + c = 0", "x", {"a": 1, "b": -3, "c": 2})
        expect(g["roots"][1]).toBeCloseTo(2, 12)
        expect(fn() { Eq.solve("a x + b = 0", "x") }).toThrow()
        expect(fn() { Eq.solve("a x + b = 0") }).toThrow()
        expect(fn() { Eq.solve("x = = 1") }).toThrow()
        expect(Eq.solve("y^2 = 9")["variable"]).toBe("y")
    })
    it("expands formulas", fn() {
        expect(Eq.expand("(x + 1)^3")).toBe("x^3 + 3x^2 + 3x + 1")
        expect(Eq.expand("(x - 2)(x + 2)")).toBe("x^2 - 4")
        expect(Eq.expand("3(x + 1) - 2(x - 1)")).toBe("x + 5")
        expect(Eq.expand("(a + 1)^2", "a")).toBe("a^2 + 2a + 1")
        expect(Eq.toPoly("sin(x)", "x")).toBeNull()
        expect(Eq.toPoly("2^3 x", "x")).toEqual([8, 0])
        expect(fn() { Eq.expand("sin(x)", "x") }).toThrow()
    })
})

describe("Eq numeric equations", fn() {
    it("solves transcendental equations", fn() {
        let r = Eq.solve("cos(x) = x", "x")
        expect(r["method"]).toBe("numeric")
        expect(r["roots"][0]).toBeCloseTo(0.7390851332151607, 11)
        let e = Eq.solve("exp(x) = 5", "x")
        expect(e["roots"][0]).toBeCloseTo(log(5), 11)
        let s = Eq.solve("sin(x) = 0.5", "x", {}, {"range": [0, 7]})
        expect(len(s["roots"])).toBe(3)
        expect(s["roots"][0]).toBeCloseTo(PI / 6, 11)
        let l = Eq.solve("ln(x) + x = 2", "x", {}, {"range": [0.01, 10]})
        expect(l["roots"][0]).toBeCloseTo(1.5571455989976113, 9)
        let g = Eq.solve("x^3 + sin(x) - 2", "x", {}, {"guess": 1})
        expect(g["roots"][0] ^ 3 + sin(g["roots"][0])).toBeCloseTo(2, 11)
    })
    it("ignores poles and flags nothing spurious", fn() {
        let r = Eq.solve("1 / x = 0", "x", {}, {"range": [-5, 5]})
        expect(r["roots"]).toEqual([])
        let t = Eq.solve("tan(x) = 1", "x", {}, {"range": [0, 3]})
        expect(len(t["roots"])).toBe(1)
        expect(t["roots"][0]).toBeCloseTo(PI / 4, 11)
        expect(Eq.root("x^2 = 2", "x", 0, 2)).toBeCloseTo(sqrt(2), 12)
    })
})

describe("Eq systems", fn() {
    it("solves linear systems", fn() {
        let s = Eq.solveSystem(["x + y = 3", "x - y = 1"], ["x", "y"])
        expect(s["type"]).toBe("unique")
        expect(s["solution"]["x"]).toBeCloseTo(2, 12)
        expect(s["solution"]["y"]).toBeCloseTo(1, 12)
        let t = Eq.solveSystem(["2x + 3y - z = 5", "x - y + 2z = 1", "3x + y + z = 8"], ["x", "y", "z"])
        expect(t["type"]).toBe("unique")
        expect(2 * t["solution"]["x"] + 3 * t["solution"]["y"] - t["solution"]["z"]).toBeCloseTo(5, 10)
        expect(t["solution"]["x"] + t["solution"]["y"] * -1 + 2 * t["solution"]["z"]).toBeCloseTo(1, 10)
        let none = Eq.solveSystem(["x + y = 1", "x + y = 2"], ["x", "y"])
        expect(none["type"]).toBe("none")
        let inf = Eq.solveSystem(["x + y = 2", "2x + 2y = 4"], ["x", "y"])
        expect(inf["type"]).toBe("infinite")
        expect(inf["free"]).toEqual(["y"])
        expect(inf["particular"]["x"]).toBe(2)
        let withParam = Eq.solveSystem(["a x + y = 5", "x - y = 1"], ["x", "y"], {"vars": {"a": 2}})
        expect(withParam["solution"]["x"]).toBeCloseTo(2, 12)
    })
    it("solves nonlinear systems", fn() {
        let c = Eq.solveSystem(["x^2 + y^2 = 25", "y = x + 1"], ["x", "y"])
        expect(c["type"]).toBe("nonlinear")
        expect(len(c["solutions"])).toBe(2)
        let found = c["solutions"].map(fn(s) { return Num.roundTo(s["x"], 6) + "," + Num.roundTo(s["y"], 6) })
        expect(found.includes("3,4")).toBeTruthy()
        expect(found.includes("-4,-3")).toBeTruthy()
        let g = Eq.solveSystem(["x*y = 6", "x + y = 5"], ["x", "y"])
        expect(len(g["solutions"])).toBe(2)
        let w = Eq.solveSystem(["exp(x) = y", "y + x = 2"], ["x", "y"])
        expect(len(w["solutions"])).toBe(1)
        expect(w["solutions"][0]["x"]).toBeCloseTo(0.4428544010023885, 8)
        let guessed = Eq.solveSystem(["x^2 + y^2 = 25", "y = x + 1"], ["x", "y"], {"guess": [5, 5]})
        expect(len(guessed["solutions"])).toBe(1)
        expect(guessed["solutions"][0]["x"]).toBeCloseTo(3, 8)
        expect(fn() { Eq.solveSystem(["x^2 = y", "x*y = 1", "x + y = 3"], ["x", "y"]) }).toThrow()
    })
})

describe("Eq analysis helpers", fn() {
    it("builds tables, integrals and limits", fn() {
        let t = Eq.table("x^2", "x", 0, 4, 1)
        expect(t).toEqual([[0, 0], [1, 1], [2, 4], [3, 9], [4, 16]])
        expect(Eq.integral("x^2", "x", 0, 3)).toBeCloseTo(9, 9)
        expect(Eq.integral("exp(-x^2)", "x", -INF, INF)).toBeCloseTo(sqrt(PI), 8)
        expect(Eq.limit("sin(x)/x", "x", 0)).toBeCloseTo(1, 6)
        expect(Eq.integral("a x", "x", 0, 2, {"a": 3})).toBeCloseTo(6, 9)
    })
    it("builds Taylor polynomials", fn() {
        expect(Eq.taylor("exp(x)", "x", 0, 3)["coefficients"][3]).toBeCloseTo(1 / 6, 12)
        expect(Eq.taylor("sin(x)", "x", 0, 5)["text"]).toBe("x - 0.166667x^3 + 0.008333x^5")
        expect(Eq.taylor("1/(1 - x)", "x", 0, 3)["coefficients"]).toEqual([1, 1, 1, 1])
        expect(Eq.taylor("x^2", "x", 1, 2)["text"]).toBe("(x - 1)^2 + 2(x - 1) + 1")
        expect(Eq.taylor("ln(x)", "x", 1, 3)["coefficients"][2]).toBeCloseTo(-0.5, 12)
    })
    it("checks equations and equivalence", fn() {
        expect(Eq.check("2 + 2 = 4")["holds"]).toBeTruthy()
        expect(Eq.check("x^2 = 9", {"x": 3})["holds"]).toBeTruthy()
        expect(Eq.check("x^2 = 9", {"x": 2})["holds"]).toBeFalsy()
        expect(Eq.equivalent("(x+1)^2", "x^2 + 2x + 1")).toBeTruthy()
        expect(Eq.equivalent("sin(x)^2 + cos(x)^2", "1")).toBeTruthy()
        expect(Eq.equivalent("(x+1)^2", "x^2 + 1")).toBeFalsy()
        expect(Eq.equivalent("a b", "b a")).toBeTruthy()
        expect(Eq.simplify("2x + 3x")).toBe("5x")
    })
})

Test.report()
