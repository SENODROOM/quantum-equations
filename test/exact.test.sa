# @use quantum-test
# @use ../src/numtheory.sa
# @use ../src/fraction.sa

describe("NumTheory", fn() {
    it("runs the extended Euclidean algorithm", fn() {
        let e = NumTheory.extGcd(240, 46)
        expect(e["g"]).toBe(2)
        expect(240 * e["x"] + 46 * e["y"]).toBe(2)
        expect(NumTheory.modInverse(3, 11)).toBe(4)
        expect(fn() { NumTheory.modInverse(4, 8) }).toThrow()
        expect(NumTheory.modPow(2, 10, 1000)).toBe(24)
        expect(NumTheory.modPow(7, 560, 561)).toBe(1)
        expect(NumTheory.modPow(3, 200, 13)).toBe(9)
        expect(NumTheory.mulMod(123456789012, 987654321098, 1000000007)).toBe(NumTheory.mulMod(987654321098, 123456789012, 1000000007))
    })
    it("solves linear Diophantine equations", fn() {
        let s = NumTheory.linearDiophantine(3, 5, 1)
        expect(3 * s["x0"] + 5 * s["y0"]).toBe(1)
        expect(3 * (s["x0"] + 4 * s["dx"]) + 5 * (s["y0"] + 4 * s["dy"])).toBe(1)
        expect(NumTheory.linearDiophantine(6, 9, 4)).toBeNull()
        let t = NumTheory.smallestPositiveDiophantine(3, 5, 22)
        expect(3 * t["x"] + 5 * t["y"]).toBe(22)
        expect(t["x"]).toBeGreaterThan(-1)
        expect(NumTheory.smallestPositiveDiophantine(3, 5, 1)).toBeNull()
    })
    it("solves congruences and the Chinese remainder theorem", fn() {
        expect(NumTheory.linearCongruence(3, 4, 7)).toEqual([6])
        expect(NumTheory.linearCongruence(6, 4, 10)).toEqual([4, 9])
        expect(NumTheory.linearCongruence(2, 1, 4)).toEqual([])
        let c = NumTheory.crt([2, 3, 2], [3, 5, 7])
        expect(c["x"]).toBe(23)
        expect(c["modulus"]).toBe(105)
        let nc = NumTheory.crt([1, 3], [4, 6])
        expect(nc["x"]).toBe(9)
        expect(nc["modulus"]).toBe(12)
        expect(NumTheory.crt([1, 2], [4, 6])).toBeNull()
    })
    it("solves Pell's equation", fn() {
        expect(NumTheory.pell(2)).toEqual({"x": 3, "y": 2})
        expect(NumTheory.pell(7)).toEqual({"x": 8, "y": 3})
        expect(NumTheory.pell(13)).toEqual({"x": 649, "y": 180})
        expect(NumTheory.pell(61)).toEqual({"x": 1766319049, "y": 226153980})
        expect(NumTheory.pell(9)).toBeNull()
    })
    it("tests primes and factors numbers", fn() {
        expect(NumTheory.isPrime(2)).toBeTruthy()
        expect(NumTheory.isPrime(97)).toBeTruthy()
        expect(NumTheory.isPrime(561)).toBeFalsy()
        expect(NumTheory.isPrime(1000000007)).toBeTruthy()
        expect(NumTheory.isPrime(1000000007 * 3)).toBeFalsy()
        expect(NumTheory.isPrime(1)).toBeFalsy()
        expect(NumTheory.factorize(360)).toEqual([2, 2, 2, 3, 3, 5])
        expect(NumTheory.factorize(97)).toEqual([97])
        expect(NumTheory.totient(36)).toBe(12)
        expect(NumTheory.totient(97)).toBe(96)
        expect(len(NumTheory.pythagoreanTriples(30))).toBe(11)
    })
})

describe("Frac", fn() {
    it("normalises and does arithmetic", fn() {
        expect(Frac.make(2, 4)).toEqual({"n": 1, "d": 2})
        expect(Frac.make(1, -3)).toEqual({"n": -1, "d": 3})
        expect(Frac.show(Frac.add(Frac.make(1, 3), Frac.make(1, 6)))).toBe("1/2")
        expect(Frac.show(Frac.sub(Frac.make(1, 3), Frac.make(1, 2)))).toBe("-1/6")
        expect(Frac.show(Frac.mul(Frac.make(2, 3), Frac.make(3, 4)))).toBe("1/2")
        expect(Frac.show(Frac.div(Frac.make(1, 2), Frac.make(1, 4)))).toBe("2")
        expect(Frac.show(Frac.powInt(Frac.make(2, 3), 3))).toBe("8/27")
        expect(Frac.show(Frac.powInt(Frac.make(2, 3), -2))).toBe("9/4")
        expect(fn() { Frac.make(1, 0) }).toThrow()
        expect(fn() { Frac.div(1, 0) }).toThrow()
    })
    it("compares and converts", fn() {
        expect(Frac.compare(Frac.make(1, 3), Frac.make(1, 2))).toBe(-1)
        expect(Frac.equals(Frac.make(2, 4), 0.5)).toBeTruthy()
        expect(Frac.toNumber(Frac.make(3, 8))).toBe(0.375)
        expect(Frac.show(Frac.fromNumber(0.75))).toBe("3/4")
        expect(Frac.show(Frac.fromNumber(1 / 3))).toBe("1/3")
        expect(Frac.show(Frac.fromNumber(-2.5))).toBe("-5/2")
        expect(Frac.show(Frac.fromNumber(PI, 100))).toBe("22/7")
        expect(Frac.showMixed(Frac.make(7, 2))).toBe("3 1/2")
        expect(Frac.showMixed(Frac.make(-7, 2))).toBe("-3 1/2")
        expect(Frac.isWhole(Frac.make(6, 3))).toBeTruthy()
    })
    it("solves systems and determinants exactly", fn() {
        let x = Frac.solveSystem([[2, 1], [1, 3]], [3, 5])
        expect(Frac.showAll(x)).toEqual(["4/5", "7/5"])
        let y = Frac.solveSystem([[1, 1, 1], [0, 2, 5], [2, 5, -1]], [6, -4, 27])
        expect(Frac.showAll(y)).toEqual(["5", "3", "-2"])
        expect(Frac.show(Frac.det([[1, 2], [3, 4]]))).toBe("-2")
        expect(Frac.show(Frac.det([[2, 0, 1], [1, 3, 2], [1, 1, 2]]))).toBe("6")
        expect(Frac.show(Frac.det([[1, 2], [2, 4]]))).toBe("0")
        expect(fn() { Frac.solveSystem([[1, 2], [2, 4]], [1, 2]) }).toThrow()
        let half = Frac.solveSystem([[0.5, 0.25], [1, 1]], [1, 3])
        expect(Frac.showAll(half)).toEqual(["1", "2"])
    })
})
