# @use quantum-test
# @use ../src/core.sa
# @use ../src/complex.sa

describe("Num", fn() {
    it("compares and formats numbers", fn() {
        expect(Num.approx(0.1 + 0.2, 0.3)).toBeTruthy()
        expect(Num.approx(1, 1.1)).toBeFalsy()
        expect(Num.fmt(1 / 3, 6)).toBe("0.333333")
        expect(Num.fmt(2.5, 6)).toBe("2.5")
        expect(Num.fmt(-0.0000001, 3)).toBe("0")
        expect(Num.fmt(100, 4)).toBe("100")
        expect(Num.clean(0.30000000000000004 * 10)).toBe(3)
        expect(Num.roundTo(3.14159, 2)).toBe(3.14)
    })
    it("computes roots and hyperbolics", fn() {
        expect(Num.cbrt(-27)).toBeCloseTo(-3)
        expect(Num.nthRoot(32, 5)).toBeCloseTo(2)
        expect(Num.exp(1)).toBeCloseTo(2.718281828459045, 12)
        expect(Num.sinh(1)).toBeCloseTo(1.1752011936438014, 12)
        expect(Num.cosh(1)).toBeCloseTo(1.5430806348152437, 12)
        expect(Num.tanh(0.5)).toBeCloseTo(0.46211715726000974, 12)
        expect(Num.asinh(Num.sinh(0.7))).toBeCloseTo(0.7, 12)
        expect(Num.logBase(8, 2)).toBeCloseTo(3)
    })
    it("computes special functions", fn() {
        expect(Num.gamma(5)).toBeCloseTo(24, 9)
        expect(Num.gamma(0.5)).toBeCloseTo(1.7724538509055159, 12)
        expect(Num.factorial(10)).toBe(3628800)
        expect(Num.factorial(0.5)).toBeCloseTo(0.886226925452758, 12)
        expect(Num.binomial(10, 3)).toBe(120)
        expect(Num.binomial(52, 5)).toBe(2598960)
        expect(Num.erf(1)).toBeCloseTo(0.8427007929497149, 12)
        expect(Num.erf(-0.5)).toBeCloseTo(-0.5204998778130465, 12)
        expect(Num.normalCdf(1.96)).toBeCloseTo(0.9750021048517795, 10)
    })
    it("handles integer helpers", fn() {
        expect(Num.gcd(48, 18)).toBe(6)
        expect(Num.lcm(4, 6)).toBe(12)
        expect(Num.mod(-1, 5)).toBe(4)
        expect(Num.linspace(0, 1, 5)).toEqual([0, 0.25, 0.5, 0.75, 1])
        expect(Num.sum([1, 2, 3])).toBe(6)
        expect(Num.product([2, 3, 4])).toBe(24)
    })
})

describe("Complex", fn() {
    it("does arithmetic", fn() {
        let a = Complex.make(3, 4)
        let b = Complex.make(1, -2)
        expect(Complex.add(a, b)).toEqual({"re": 4, "im": 2})
        expect(Complex.sub(a, b)).toEqual({"re": 2, "im": 6})
        expect(Complex.mul(a, b)).toEqual({"re": 11, "im": -2})
        expect(Complex.show(Complex.div(a, b))).toBe("-1 + 2i")
        expect(Complex.abs(a)).toBe(5)
        expect(Complex.show(Complex.mul(a, Complex.conj(a)))).toBe("25")
    })
    it("computes powers and roots", fn() {
        expect(Complex.show(Complex.sqrt(Complex.make(-4, 0)))).toBe("2i")
        expect(Complex.show(Complex.sqrt(Complex.make(3, 4)))).toBe("2 + i")
        expect(Complex.show(Complex.powInt(Complex.make(0, 1), 2))).toBe("-1")
        expect(Complex.show(Complex.pow(Complex.make(1, 1), 4))).toBe("-4")
        let r = Complex.roots(1, 3)
        expect(len(r)).toBe(3)
        expect(Complex.abs(Complex.sub(Complex.powInt(r[1], 3), 1))).toBeCloseTo(0, 9)
    })
    it("handles Euler's identity", fn() {
        let z = Complex.exp(Complex.make(0, PI))
        expect(Complex.show(z)).toBe("-1")
        expect(Complex.show(Complex.ln(Complex.make(-1, 0)), 4)).toBe("3.1416i")
        expect(Complex.arg(Complex.make(0, 1))).toBeCloseTo(PI / 2)
    })
    it("shows values", fn() {
        expect(Complex.show(Complex.make(1, -1))).toBe("1 - i")
        expect(Complex.show(Complex.make(0, -3))).toBe("-3i")
        expect(Complex.show(Complex.make(1.5, 0))).toBe("1.5")
        expect(Complex.simplify(Complex.make(2, 1e-15))).toBe(2)
    })
})

Test.report()
