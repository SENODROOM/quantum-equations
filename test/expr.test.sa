# @use quantum-test
# @use ../src/expr.sa
# @use ../src/calculus.sa

describe("Expr evaluate", fn() {
    it("respects precedence and associativity", fn() {
        expect(Expr.evaluate("3 + 4 * 2")).toBe(11)
        expect(Expr.evaluate("(3 + 4) * 2")).toBe(14)
        expect(Expr.evaluate("2 ^ 3 ^ 2")).toBe(512)
        expect(Expr.evaluate("-2 ^ 2")).toBe(-4)
        expect(Expr.evaluate("(-2) ^ 2")).toBe(4)
        expect(Expr.evaluate("2 ^ -1")).toBe(0.5)
        expect(Expr.evaluate("10 - 4 - 3")).toBe(3)
        expect(Expr.evaluate("100 / 10 / 5")).toBe(2)
        expect(Expr.evaluate("17 % 5")).toBe(2)
        expect(Expr.evaluate("-17 % 5")).toBe(3)
        expect(Expr.evaluate("2 ** 10")).toBe(1024)
        expect(Expr.evaluate("5!")).toBe(120)
        expect(Expr.evaluate("3 + -2")).toBe(1)
        expect(Expr.evaluate("--4")).toBe(4)
    })
    it("reads numbers", fn() {
        expect(Expr.evaluate("1.5e3")).toBe(1500)
        expect(Expr.evaluate("2E-2")).toBe(0.02)
        expect(Expr.evaluate(".5 + .25")).toBe(0.75)
        expect(Expr.evaluate("1e2e")).toBeCloseTo(100 * 2.718281828459045, 9)
    })
    it("supports variables, constants and implicit multiplication", fn() {
        expect(Expr.evaluate("2x + 1", {"x": 4})).toBe(9)
        expect(Expr.evaluate("3(x + 1)", {"x": 2})).toBe(9)
        expect(Expr.evaluate("(x + 1)(x - 1)", {"x": 5})).toBe(24)
        expect(Expr.evaluate("2pi")).toBeCloseTo(2 * PI, 12)
        expect(Expr.evaluate("x y", {"x": 3, "y": 4})).toBe(12)
        expect(Expr.evaluate("2x^2", {"x": 3})).toBe(18)
        expect(Expr.evaluate("x(x+1)", {"x": 3})).toBe(12)
        expect(Expr.evaluate("e ^ 1")).toBeCloseTo(2.718281828459045, 12)
        expect(Expr.evaluate("pi", {"pi": 3})).toBe(3)
        expect(Expr.evaluate("2 sin(pi/2)")).toBeCloseTo(2, 12)
    })
    it("evaluates functions", fn() {
        expect(Expr.evaluate("sqrt(16) + abs(-3)")).toBe(7)
        expect(Expr.evaluate("sin(0) + cos(0)")).toBe(1)
        expect(Expr.evaluate("ln(e)")).toBeCloseTo(1, 12)
        expect(Expr.evaluate("log(1000)")).toBeCloseTo(3, 12)
        expect(Expr.evaluate("log(8, 2)")).toBeCloseTo(3, 12)
        expect(Expr.evaluate("log2(32)")).toBeCloseTo(5, 12)
        expect(Expr.evaluate("max(1, 7, 3) - min(4, 2, 9)")).toBe(5)
        expect(Expr.evaluate("floor(2.7) + ceil(2.1) + round(2.5)")).toBe(8)
        expect(Expr.evaluate("pow(2, 8)")).toBe(256)
        expect(Expr.evaluate("hypot(3, 4)")).toBe(5)
        expect(Expr.evaluate("cbrt(-27)")).toBeCloseTo(-3, 12)
        expect(Expr.evaluate("root(81, 4)")).toBeCloseTo(3, 12)
        expect(Expr.evaluate("sinh(0) + cosh(0)")).toBe(1)
        expect(Expr.evaluate("atan2(1, 1)")).toBeCloseTo(PI / 4, 12)
        expect(Expr.evaluate("gamma(5)")).toBeCloseTo(24, 9)
        expect(Expr.evaluate("deg(pi)")).toBeCloseTo(180, 9)
        expect(Expr.evaluate("mod(-1, 5)")).toBe(4)
        expect(Expr.evaluate("fact(6)")).toBe(720)
    })
    it("never raises on division by zero", fn() {
        expect(Expr.evaluate("1/0")).toBe(INF)
        expect(Expr.evaluate("-1/0")).toBe(-INF)
        expect(isNaN(Expr.evaluate("0/0"))).toBeTruthy()
        expect(isNaN(Expr.evaluate("5 % 0"))).toBeTruthy()
        expect(isNaN(Expr.evaluate("sqrt(-1)"))).toBeTruthy()
    })
    it("reports errors clearly", fn() {
        expect(fn() { Expr.evaluate("2 +") }).toThrow()
        expect(fn() { Expr.evaluate("(1 + 2") }).toThrow()
        expect(fn() { Expr.evaluate("1 $ 2") }).toThrow()
        expect(fn() { Expr.evaluate("y + 1", {"x": 1}) }).toThrow()
        expect(fn() { Expr.evaluate("sin 2") }).toThrow()
        expect(fn() { Expr.evaluate("sin(1, 2)") }).toThrow()
        expect(fn() { Expr.evaluate("1 2 )") }).toThrow()
    })
    it("compiles to real functions", fn() {
        let f = Expr.compile("x^3 - 2x", "x")
        expect(f(2)).toBe(4)
        expect(f(3)).toBe(21)
        let g = Expr.compile("a x + b", "x", {"a": 2, "b": 1})
        expect(g(5)).toBe(11)
        let h = Expr.compile("x * y + 1", ["x", "y"])
        expect(h(3, 4)).toBe(13)
        let k = Expr.compile("x + y + z", ["x", "y", "z"])
        expect(k(1, 2, 3)).toBe(6)
        let v = Expr.compileVector("x^2 + y^2", ["x", "y"])
        expect(v([3, 4])).toBe(25)
        expect(Calc.integrate(Expr.compile("x^2", "x"), 0, 3)).toBeCloseTo(9, 9)
    })
    it("lists variables", fn() {
        expect(Expr.variables("a x^2 + b x + c + pi")).toEqual(["a", "x", "b", "c"])
        expect(Expr.variables("sin(t) * t")).toEqual(["t"])
        expect(Expr.variables("2 + 3")).toEqual([])
    })
})

describe("Expr show & simplify", fn() {
    it("prints formulas with minimal parentheses", fn() {
        expect(Expr.show("(1+2)*3")).toBe("(1 + 2)*3")
        expect(Expr.show("2*x")).toBe("2x")
        expect(Expr.show("3*x^2")).toBe("3x^2")
        expect(Expr.show("2*sin(x)")).toBe("2sin(x)")
        expect(Expr.show("2*3")).toBe("2*3")
        expect(Expr.show("a-(b-c)")).toBe("a - (b - c)")
        expect(Expr.show("a-b-c")).toBe("a - b - c")
        expect(Expr.show("(a+b)^2")).toBe("(a + b)^2")
        expect(Expr.show("a/(b*c)")).toBe("a / (b*c)")
        expect(Expr.show("x^-1")).toBe("x^(-1)")
        expect(Expr.show("-(x+1)")).toBe("-(x + 1)")
        expect(Expr.show("(-2)^2")).toBe("(-2)^2")
        expect(Expr.show("2*e")).toBe("2*e")
        expect(Expr.show("max(1,x)")).toBe("max(1, x)")
        expect(Expr.show("0.1+0.25")).toBe("0.1 + 0.25")
    })
    it("round-trips through the parser", fn() {
        let srcs = ["2x^2 - 3x + 1", "sin(x)*cos(x)/2", "(x+1)^(2-x)", "-x^2 + e^x", "a/(b+c)*d"]
        for s in srcs {
            let once = Expr.show(s)
            expect(Expr.show(once)).toBe(once)
            let vars = {"x": 0.7, "a": 2, "b": 3, "c": 4, "d": 5}
            expect(Expr.evaluate(once, vars)).toBeCloseTo(Expr.evaluate(s, vars), 10)
        }
    })
    it("simplifies", fn() {
        expect(Expr.simplify("x*1 + 0 + 2*3")).toBe("x + 6")
        expect(Expr.simplify("0*x + y")).toBe("y")
        expect(Expr.simplify("x + x")).toBe("2x")
        expect(Expr.simplify("x * x")).toBe("x^2")
        expect(Expr.simplify("x - x")).toBe("0")
        expect(Expr.simplify("x / x")).toBe("1")
        expect(Expr.simplify("x^1 + x^0")).toBe("x + 1")
        expect(Expr.simplify("2 * (3 * x)")).toBe("6x")
        expect(Expr.simplify("(x * 3) * 2")).toBe("6x")
        expect(Expr.simplify("x * 2")).toBe("2x")
        expect(Expr.simplify("x - -3")).toBe("x + 3")
        expect(Expr.simplify("x + -3")).toBe("x - 3")
        expect(Expr.simplify("--x")).toBe("x")
        expect(Expr.simplify("x * x^2")).toBe("x^3")
        expect(Expr.simplify("sqrt(16) + 2^3 + 10/5")).toBe("14")
        expect(Expr.simplify("1/3 + 0")).toBe("1 / 3")
        expect(Expr.simplify("4! + 1")).toBe("25")
        expect(Expr.simplify("sin(0) + x")).toBe("x")
        expect(Expr.simplify("-1 * x")).toBe("-x")
    })
})

describe("Expr derivative", fn() {
    it("applies the basic rules", fn() {
        expect(Expr.derivative("5", "x")).toBe("0")
        expect(Expr.derivative("x", "x")).toBe("1")
        expect(Expr.derivative("y", "x")).toBe("0")
        expect(Expr.derivative("x^2", "x")).toBe("2x")
        expect(Expr.derivative("x^3", "x")).toBe("3x^2")
        expect(Expr.derivative("3x^2 + 2x + 1", "x")).toBe("6x + 2")
        expect(Expr.derivative("x^2 - x", "x")).toBe("2x - 1")
        expect(Expr.derivative("sin(x)", "x")).toBe("cos(x)")
        expect(Expr.derivative("cos(x)", "x")).toBe("-sin(x)")
        expect(Expr.derivative("exp(x)", "x")).toBe("exp(x)")
        expect(Expr.derivative("ln(x)", "x")).toBe("1 / x")
        expect(Expr.derivative("1/x", "x")).toBe("-1 / x^2")
        expect(Expr.derivative("sqrt(x)", "x")).toBe("1 / (2sqrt(x))")
    })
    it("applies the product, quotient and chain rules", fn() {
        expect(Expr.derivative("x^2 * sin(x)", "x")).toBe("2x*sin(x) + x^2*cos(x)")
        expect(Expr.derivative("sin(x^2)", "x")).toBe("2x*cos(x^2)")
        expect(Expr.derivative("(2x+1)^3", "x")).toBe("6(2x + 1)^2")
        expect(Expr.derivative("exp(2x)", "x")).toBe("2exp(2x)")
        expect(Expr.derivative("ln(3x)", "x")).toBe("3 / (3x)")
    })
    it("matches numeric differentiation", fn() {
        let formulas = [
            "x^3 * cos(x)", "exp(x) / (1 + x^2)", "atan(x) + asin(x/3)", "x^x", "2^x + x^2",
            "sqrt(1 + x^2)", "tanh(x) * ln(x + 5)", "sin(cos(x))", "log(x + 3)", "cbrt(x) + abs(x)",
            "sinh(x)/cosh(x)", "1/(1 + exp(-x))", "x^2.5 + (x+3)^-2", "tan(x/2)", "acosh(x + 3) + atanh(x/4)"
        ]
        for fs in formulas {
            let d = Expr.derivative(fs, "x")
            let f = Expr.compile(fs, "x")
            let g = Expr.compile(d, "x")
            let x0 = 0.8
            expect(g(x0)).toBeCloseTo(Calc.derivative(f, x0), 6)
        }
    })
    it("differentiates repeatedly and partially", fn() {
        expect(Expr.derivative("x^4", "x", 2)).toBe("12x^2")
        expect(Expr.derivative("sin(x)", "x", 4)).toBe("sin(x)")
        expect(Expr.derivative("x^2 * y^3", "y")).toBe("3x^2*y^2")
        expect(Expr.derivative("x^2 * y^3", "x")).toBe("2x*y^3")
        expect(Expr.derivative("5x", "x", 2)).toBe("0")
        expect(fn() { Expr.derivative("floor(x)", "x") }).toThrow()
        expect(fn() { Expr.derivative("x!", "x") }).toThrow()
    })
})

Test.report()
