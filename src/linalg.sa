# quantum-equations / linalg — vectors, matrices and linear systems
#
#   LinAlg.solve([[2, 1], [1, 3]], [3, 5])          # [0.8, 1.4]
#   LinAlg.det([[1, 2], [3, 4]])                    # -2
#   LinAlg.inverse([[4, 7], [2, 6]])                # [[0.6, -0.7], [-0.2, 0.4]]
#   LinAlg.analyze([[1, 1], [2, 2]], [2, 4])        # {"type": "infinite", ...}
#
# Matrices are arrays of row arrays; vectors are plain arrays.
# Exposes the global: LinAlg

# @use ./core.sa
# @use ./complex.sa

class __LinAlg {
    fn init() {
        self.TOL = 1e-12
    }

    # ── construction ─────────────────────────────────────────────────────

    fn zeros(rows, cols) {
        if cols == null { cols = rows }
        let m = []
        for i in range(rows) {
            let row = []
            for j in range(cols) { row.push(0) }
            m.push(row)
        }
        return m
    }

    fn identity(n) {
        let m = self.zeros(n, n)
        for i in range(n) { m[i][i] = 1 }
        return m
    }

    fn diag(values) {
        let n = len(values)
        let m = self.zeros(n, n)
        for i in range(n) { m[i][i] = values[i] }
        return m
    }

    fn copy(a) {
        let out = []
        for row in a { out.push(row.slice(0)) }
        return out
    }

    fn rows(a) { return len(a) }
    fn cols(a) { return len(a[0]) }

    # ── elementwise & products ───────────────────────────────────────────

    fn transpose(a) {
        let r = len(a)
        let c = len(a[0])
        let out = self.zeros(c, r)
        for i in range(r) {
            for j in range(c) { out[j][i] = a[i][j] }
        }
        return out
    }

    fn add(a, b) {
        let out = self.copy(a)
        for i in range(len(a)) {
            for j in range(len(a[0])) { out[i][j] = a[i][j] + b[i][j] }
        }
        return out
    }

    fn sub(a, b) {
        let out = self.copy(a)
        for i in range(len(a)) {
            for j in range(len(a[0])) { out[i][j] = a[i][j] - b[i][j] }
        }
        return out
    }

    fn scale(a, k) {
        let out = self.copy(a)
        for i in range(len(a)) {
            for j in range(len(a[0])) { out[i][j] = a[i][j] * k }
        }
        return out
    }

    fn multiply(a, b) {
        let n = len(a)
        let m = len(b)
        let p = len(b[0])
        if len(a[0]) != m { raise "multiply: dimension mismatch" }
        let out = self.zeros(n, p)
        for i in range(n) {
            for j in range(p) {
                let s = 0
                for k in range(m) { s = s + a[i][k] * b[k][j] }
                out[i][j] = s
            }
        }
        return out
    }

    # Matrix x vector.
    fn mulVec(a, v) {
        let out = []
        for row in a {
            let s = 0
            for k in range(len(v)) { s = s + row[k] * v[k] }
            out.push(s)
        }
        return out
    }

    fn power(a, n) {
        let result = self.identity(len(a))
        let base = self.copy(a)
        while n > 0 {
            if n % 2 == 1 { result = self.multiply(result, base) }
            base = self.multiply(base, base)
            n = floor(n / 2)
        }
        return result
    }

    fn trace(a) {
        let s = 0
        for i in range(len(a)) { s = s + a[i][i] }
        return s
    }

    # ── vectors ──────────────────────────────────────────────────────────

    fn dot(a, b) {
        let s = 0
        for i in range(len(a)) { s = s + a[i] * b[i] }
        return s
    }

    fn norm(v) { return sqrt(self.dot(v, v)) }

    fn cross(a, b) {
        return [
            a[1] * b[2] - a[2] * b[1],
            a[2] * b[0] - a[0] * b[2],
            a[0] * b[1] - a[1] * b[0]
        ]
    }

    fn unit(v) {
        let n = self.norm(v)
        if n == 0 { raise "cannot normalise the zero vector" }
        return v.map(fn(x) { return x / n })
    }

    # ── elimination ──────────────────────────────────────────────────────

    fn maxAbs(a) {
        let m = 0
        for row in a {
            for x in row { if abs(x) > m { m = abs(x) } }
        }
        return m
    }

    # Determinant by Gaussian elimination with partial pivoting.
    fn det(a) {
        let n = len(a)
        if n != len(a[0]) { raise "det: matrix must be square" }
        let m = self.copy(a)
        let tol = self.TOL * max(1, self.maxAbs(a))
        let d = 1
        for c in range(n) {
            let p = c
            for r in range(c + 1, n) {
                if abs(m[r][c]) > abs(m[p][c]) { p = r }
            }
            if abs(m[p][c]) <= tol { return 0 }
            if p != c {
                let tmp = m[p]
                m[p] = m[c]
                m[c] = tmp
                d = -d
            }
            d = d * m[c][c]
            for r in range(c + 1, n) {
                let f = m[r][c] / m[c][c]
                for k in range(c, n) { m[r][k] = m[r][k] - f * m[c][k] }
            }
        }
        return d
    }

    # Reduced row echelon form. Returns {"matrix", "pivots"} (pivot column per row).
    fn rref(a) {
        let m = self.copy(a)
        let rows = len(m)
        let cols = len(m[0])
        let tol = self.TOL * max(1, self.maxAbs(a))
        let pivots = []
        let r = 0
        for c in range(cols) {
            if r >= rows { break }
            let p = r
            for i in range(r + 1, rows) {
                if abs(m[i][c]) > abs(m[p][c]) { p = i }
            }
            if abs(m[p][c]) <= tol { continue }
            let tmp = m[p]
            m[p] = m[r]
            m[r] = tmp
            let pv = m[r][c]
            for k in range(cols) { m[r][k] = m[r][k] / pv }
            for i in range(rows) {
                if i != r {
                    let f = m[i][c]
                    if f != 0 {
                        for k in range(cols) { m[i][k] = m[i][k] - f * m[r][k] }
                    }
                }
            }
            pivots.push(c)
            r = r + 1
        }
        for i in range(rows) {
            for k in range(cols) {
                if abs(m[i][k]) < tol { m[i][k] = 0 }
            }
        }
        return {"matrix": m, "pivots": pivots}
    }

    fn rank(a) { return len(self.rref(a)["pivots"]) }

    # Solves A x = b (A square, b a vector). Raises when A is singular.
    fn solve(a, b) {
        let n = len(a)
        if n != len(a[0]) { raise "solve: matrix must be square (use leastSquares for tall systems)" }
        if len(b) != n { raise "solve: b must have " + str(n) + " entries" }
        let m = []
        for i in range(n) { m.push(a[i].concat([b[i]])) }
        let tol = self.TOL * max(1, self.maxAbs(a))
        for c in range(n) {
            let p = c
            for r in range(c + 1, n) {
                if abs(m[r][c]) > abs(m[p][c]) { p = r }
            }
            if abs(m[p][c]) <= tol { raise "solve: the matrix is singular" }
            let tmp = m[p]
            m[p] = m[c]
            m[c] = tmp
            for r in range(c + 1, n) {
                let f = m[r][c] / m[c][c]
                if f != 0 {
                    for k in range(c, n + 1) { m[r][k] = m[r][k] - f * m[c][k] }
                }
            }
        }
        let x = []
        for i in range(n) { x.push(0) }
        for i in range(n - 1, -1, -1) {
            let s = m[i][n]
            for k in range(i + 1, n) { s = s - m[i][k] * x[k] }
            x[i] = s / m[i][i]
        }
        return x
    }

    fn inverse(a) {
        let n = len(a)
        if n != len(a[0]) { raise "inverse: matrix must be square" }
        let aug = []
        for i in range(n) {
            let row = a[i].slice(0)
            for j in range(n) { row.push(i == j ? 1 : 0) }
            aug.push(row)
        }
        let res = self.rref(aug)
        if len(res["pivots"]) < n or res["pivots"][n - 1] >= n {
            raise "inverse: the matrix is singular"
        }
        let out = []
        for i in range(n) { out.push(res["matrix"][i].slice(n)) }
        return out
    }

    # Classifies A x = b.
    #   {"type": "unique",   "solution": [...]}
    #   {"type": "none"}
    #   {"type": "infinite", "particular": [...], "free": [column indexes], "rank": r}
    fn analyze(a, b) {
        let n = len(a)
        let cols = len(a[0])
        let aug = []
        for i in range(n) { aug.push(a[i].concat([b[i]])) }
        let res = self.rref(aug)
        let pivots = res["pivots"]
        for p in pivots {
            if p == cols { return {"type": "none"} }
        }
        if len(pivots) == cols {
            let sol = []
            for i in range(cols) { sol.push(res["matrix"][i][cols]) }
            return {"type": "unique", "solution": sol}
        }
        let particular = []
        for i in range(cols) { particular.push(0) }
        let free = []
        for j in range(cols) {
            if not (j in pivots) { free.push(j) }
        }
        for i in range(len(pivots)) {
            particular[pivots[i]] = res["matrix"][i][cols]
        }
        return {"type": "infinite", "particular": particular, "free": free, "rank": len(pivots)}
    }

    # Least-squares solution of an over-determined A x ~ b (normal equations).
    fn leastSquares(a, b) {
        let at = self.transpose(a)
        return self.solve(self.multiply(at, a), self.mulVec(at, b))
    }

    # ── eigenvalues ──────────────────────────────────────────────────────

    # Closed-form eigenvalues of a 2x2 matrix as complex numbers.
    fn eigen2(a) {
        let tr = a[0][0] + a[1][1]
        let dt = a[0][0] * a[1][1] - a[0][1] * a[1][0]
        let disc = tr * tr / 4 - dt
        if disc >= 0 {
            let s = sqrt(disc)
            return [Complex.make(tr / 2 + s, 0), Complex.make(tr / 2 - s, 0)]
        }
        let s = sqrt(-disc)
        return [Complex.make(tr / 2, s), Complex.make(tr / 2, -s)]
    }

    # Dominant eigenpair by power iteration -> {"value", "vector", "iterations"}.
    fn powerIteration(a, maxIter, tol) {
        if maxIter == null { maxIter = 1000 }
        if tol == null { tol = 1e-12 }
        let n = len(a)
        let v = []
        for i in range(n) { v.push(1 / (i + 1)) }
        v = self.unit(v)
        let value = 0
        let it = 0
        for k in range(maxIter) {
            it = k + 1
            let w = self.mulVec(a, v)
            let nw = self.norm(w)
            if nw == 0 { return {"value": 0, "vector": v, "iterations": it} }
            let next = self.dot(v, w)
            w = w.map(fn(x) { return x / nw })
            let done = abs(next - value) < tol * max(1, abs(next))
            value = next
            v = w
            if done and k > 0 { break }
        }
        return {"value": value, "vector": v, "iterations": it}
    }

    # Eigen-decomposition of a symmetric matrix (cyclic Jacobi rotations).
    # Returns {"values": [...descending], "vectors": [[...], ...]} where vectors[i]
    # is the unit eigenvector for values[i].
    fn eigenSymmetric(a) {
        let n = len(a)
        let m = self.copy(a)
        let v = self.identity(n)
        for sweep in range(100) {
            let off = 0
            for i in range(n) {
                for j in range(i + 1, n) { off = off + m[i][j] * m[i][j] }
            }
            if off < 1e-22 { break }
            for p in range(n - 1) {
                for q in range(p + 1, n) {
                    if abs(m[p][q]) > 1e-300 {
                        let theta = (m[q][q] - m[p][p]) / (2 * m[p][q])
                        let t = 1 / (abs(theta) + sqrt(theta * theta + 1))
                        if theta < 0 { t = -t }
                        let c = 1 / sqrt(t * t + 1)
                        let s = t * c
                        for k in range(n) {
                            let kp = m[k][p]
                            let kq = m[k][q]
                            m[k][p] = c * kp - s * kq
                            m[k][q] = s * kp + c * kq
                        }
                        for k in range(n) {
                            let pk = m[p][k]
                            let qk = m[q][k]
                            m[p][k] = c * pk - s * qk
                            m[q][k] = s * pk + c * qk
                        }
                        for k in range(n) {
                            let vp = v[k][p]
                            let vq = v[k][q]
                            v[k][p] = c * vp - s * vq
                            v[k][q] = s * vp + c * vq
                        }
                    }
                }
            }
        }
        let order = []
        for i in range(n) { order.push(i) }
        # selection sort by eigenvalue, descending
        for i in range(n) {
            let best = i
            for j in range(i + 1, n) {
                if m[order[j]][order[j]] > m[order[best]][order[best]] { best = j }
            }
            let tmp = order[i]
            order[i] = order[best]
            order[best] = tmp
        }
        let values = []
        let vectors = []
        for idx in order {
            values.push(m[idx][idx])
            let col = []
            for k in range(n) { col.push(v[k][idx]) }
            vectors.push(col)
        }
        return {"values": values, "vectors": vectors}
    }

    # Characteristic polynomial coefficients (highest degree first, monic),
    # by the Faddeev-LeVerrier algorithm. Feed to Poly.roots for eigenvalues.
    fn charPoly(a) {
        let n = len(a)
        let coeffs = [1]
        let mk = self.identity(n)
        for k in range(1, n + 1) {
            let am = self.multiply(a, mk)
            let c = -self.trace(am) / k
            coeffs.push(c)
            mk = self.copy(am)
            for i in range(n) { mk[i][i] = mk[i][i] + c }
        }
        return coeffs
    }

    # All eigenvalues (complex) of any square matrix.
    fn eigenvalues(a) {
        if len(a) == 1 { return [Complex.make(a[0][0], 0)] }
        return Poly.roots(self.charPoly(a))
    }

    # ── display ──────────────────────────────────────────────────────────

    fn show(a, digits) {
        if digits == null { digits = 4 }
        let lines = []
        for row in a {
            let cells = row.map(fn(x) { return Num.fmt(x, digits) })
            lines.push("[ " + cells.join("  ") + " ]")
        }
        return lines.join("\n")
    }
}

LinAlg = __LinAlg()
