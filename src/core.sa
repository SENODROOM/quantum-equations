# quantum-equations / core — numeric helpers shared by every module
#
#   Num.approx(0.1 + 0.2, 0.3)      # true
#   Num.fmt(1 / 3, 6)               # "0.333333"
#   Num.gamma(5)                    # 24
#
# Exposes the global: Num

class __Num {
    fn init() {
        self.EPS = 1e-9
        self.TAU = 2 * PI
        self.PHI = (1 + sqrt(5)) / 2
        self.LANCZOS = [
            0.99999999999980993, 676.5203681218851, -1259.1392167224028,
            771.32342877765313, -176.61502916214059, 12.507343278686905,
            -0.13857109526572012, 9.9843695780195716e-6, 1.5056327351493116e-7
        ]
    }

    # ── predicates & rounding ────────────────────────────────────────────

    fn approx(a, b, eps) {
        if eps == null { eps = 1e-9 }
        if a == b { return true }
        let scale = max(1, abs(a), abs(b))
        return abs(a - b) <= eps * scale
    }

    fn isFinite(x) {
        return type(x) == "number" and not isNaN(x) and abs(x) < INF
    }

    fn sign(x) {
        if x > 0 { return 1 }
        if x < 0 { return -1 }
        return 0
    }

    fn clamp(x, lo, hi) {
        if x < lo { return lo }
        if x > hi { return hi }
        return x
    }

    fn roundTo(x, digits) {
        if digits == null { digits = 0 }
        let f = pow(10, digits)
        return round(x * f) / f
    }

    # Rounds noise away: 0.30000000000000004 -> 0.3, 1e-17 -> 0.
    fn clean(x, eps) {
        if eps == null { eps = 1e-12 }
        if abs(x) < eps { return 0 }
        let r = round(x)
        if abs(x - r) < eps * max(1, abs(x)) { return r }
        return x
    }

    # Number -> text with at most `digits` decimals and no trailing zeros
    # (the native str() keeps only 10 significant digits).
    fn fmt(x, digits) {
        if digits == null { digits = 10 }
        if isNaN(x) { return "NaN" }
        if x >= INF { return "Infinity" }
        if x <= -INF { return "-Infinity" }
        let s = sprintf("%." + str(digits) + "f", x)
        if s.contains(".") {
            while s.endsWith("0") { s = s.slice(0, len(s) - 1) }
            if s.endsWith(".") { s = s.slice(0, len(s) - 1) }
        }
        if s == "-0" { s = "0" }
        return s
    }

    # ── elementary functions the VM lacks ────────────────────────────────

    fn cbrt(x) {
        if x < 0 { return -pow(-x, 1 / 3) }
        return pow(x, 1 / 3)
    }

    fn nthRoot(x, n) {
        if x < 0 and n % 2 == 1 { return -pow(-x, 1 / n) }
        return pow(x, 1 / n)
    }

    fn exp(x) { return pow(2.718281828459045, x) }

    fn logBase(x, base) { return log(x) / log(base) }

    fn sinh(x) { return (self.exp(x) - self.exp(-x)) / 2 }
    fn cosh(x) { return (self.exp(x) + self.exp(-x)) / 2 }
    fn tanh(x) {
        if x > 20 { return 1 }
        if x < -20 { return -1 }
        let a = self.exp(2 * x)
        return (a - 1) / (a + 1)
    }
    fn asinh(x) { return log(x + sqrt(x * x + 1)) }
    fn acosh(x) { return log(x + sqrt(x * x - 1)) }
    fn atanh(x) { return 0.5 * log((1 + x) / (1 - x)) }

    fn degToRad(d) { return d * PI / 180 }
    fn radToDeg(r) { return r * 180 / PI }

    # ── special functions ────────────────────────────────────────────────

    # Gamma function (Lanczos approximation, ~15 digits). gamma(n) = (n-1)!
    fn gamma(x) {
        if x == floor(x) and x <= 0 { return INF }
        if x < 0.5 {
            return PI / (sin(PI * x) * self.gamma(1 - x))
        }
        x = x - 1
        let a = self.LANCZOS[0]
        let t = x + 7.5
        for i in range(1, 9) {
            a = a + self.LANCZOS[i] / (x + i)
        }
        return sqrt(2 * PI) * pow(t, x + 0.5) * self.exp(-t) * a
    }

    # n! — exact for whole numbers up to 170, gamma(n+1) otherwise.
    fn factorial(n) {
        if n < 0 { raise "factorial of a negative number" }
        if n == floor(n) {
            if n > 170 { return INF }
            let r = 1
            for i in range(2, n + 1) { r = r * i }
            return r
        }
        return self.gamma(n + 1)
    }

    # Binomial coefficient, exact while the result fits a double.
    fn binomial(n, k) {
        if k < 0 or k > n { return 0 }
        if k > n - k { k = n - k }
        let r = 1
        for i in range(1, k + 1) {
            r = r * (n - k + i) / i
        }
        return round(r)
    }

    # Error function. Series erf(x) = 2/sqrt(pi) * exp(-x^2) * sum 2^n x^(2n+1) / (2n+1)!!
    fn erf(x) {
        if x < 0 { return -self.erf(-x) }
        if x > 6 { return 1 }
        let term = x
        let total = x
        let n = 0
        while abs(term) > 1e-17 * abs(total) and n < 300 {
            n = n + 1
            term = term * 2 * x * x / (2 * n + 1)
            total = total + term
        }
        return 2 / sqrt(PI) * self.exp(-x * x) * total
    }

    fn erfc(x) { return 1 - self.erf(x) }

    # Standard normal CDF and PDF.
    fn normalCdf(x) { return 0.5 * (1 + self.erf(x / sqrt(2))) }
    fn normalPdf(x) { return self.exp(-x * x / 2) / sqrt(2 * PI) }

    # ── integer helpers ──────────────────────────────────────────────────

    fn gcd(a, b) {
        a = abs(a)
        b = abs(b)
        while b != 0 {
            let t = a % b
            a = b
            b = t
        }
        return a
    }

    fn lcm(a, b) {
        if a == 0 or b == 0 { return 0 }
        return abs(a / self.gcd(a, b) * b)
    }

    fn mod(a, n) { return ((a % n) + n) % n }

    fn isWhole(x, eps) {
        if eps == null { eps = 1e-9 }
        return abs(x - round(x)) < eps
    }

    # ── array helpers ────────────────────────────────────────────────────

    fn sum(values) {
        let s = 0
        for v in values { s = s + v }
        return s
    }

    fn product(values) {
        let p = 1
        for v in values { p = p * v }
        return p
    }

    fn linspace(a, b, n) {
        let out = []
        if n == 1 { return [a] }
        for i in range(n) { out.push(a + (b - a) * i / (n - 1)) }
        return out
    }
}

Num = __Num()
