# quantum-equations / fraction — exact rational arithmetic
#
#   Frac.show(Frac.add(Frac.make(1, 3), Frac.make(1, 6)))      # "1/2"
#   Frac.show(Frac.fromNumber(0.75))                           # "3/4"
#   Frac.solveSystem([[2, 1], [1, 3]], [3, 5])                 # [Frac 4/5, Frac 7/5]
#
# A fraction is {"n": numerator, "d": denominator} in lowest terms with d > 0.
# Numerators and denominators are exact up to 2^53; larger values raise.
# Exposes the global: Frac

# @use ./core.sa

class __Frac {
    fn init() {
        self.LIMIT = 9007199254740991
    }

    fn make(n, d) {
        if d == null { d = 1 }
        if d == 0 { raise "fraction with zero denominator" }
        if abs(n) > self.LIMIT or abs(d) > self.LIMIT { raise "fraction overflow (beyond 2^53)" }
        if d < 0 {
            n = -n
            d = -d
        }
        let g = Num.gcd(n, d)
        if g > 1 {
            n = n / g
            d = d / g
        }
        return {"n": n, "d": d}
    }

    # Coerces numbers (whole numbers or decimals) and fractions to a fraction.
    fn of(x) {
        if type(x) == "dict" { return x }
        if x == floor(x) { return self.make(x, 1) }
        return self.fromNumber(x, 1000000)
    }

    # Best rational approximation with denominator <= maxDen (continued fractions).
    fn fromNumber(x, maxDen) {
        if maxDen == null { maxDen = 1000000 }
        let sign = x < 0 ? -1 : 1
        let v = abs(x)
        let h1 = 1
        let h0 = 0
        let k1 = 0
        let k0 = 1
        let b = v
        for i in range(64) {
            let a = floor(b)
            let h2 = a * h1 + h0
            let k2 = a * k1 + k0
            if k2 > maxDen { break }
            h0 = h1
            h1 = h2
            k0 = k1
            k1 = k2
            if abs(v - h1 / k1) < 1e-12 * max(1, v) { break }
            if b - a == 0 { break }
            b = 1 / (b - a)
        }
        return self.make(sign * h1, k1)
    }

    fn add(a, b) {
        a = self.of(a)
        b = self.of(b)
        return self.make(a["n"] * b["d"] + b["n"] * a["d"], a["d"] * b["d"])
    }

    fn sub(a, b) {
        a = self.of(a)
        b = self.of(b)
        return self.make(a["n"] * b["d"] - b["n"] * a["d"], a["d"] * b["d"])
    }

    fn mul(a, b) {
        a = self.of(a)
        b = self.of(b)
        return self.make(a["n"] * b["n"], a["d"] * b["d"])
    }

    fn div(a, b) {
        a = self.of(a)
        b = self.of(b)
        if b["n"] == 0 { raise "fraction division by zero" }
        return self.make(a["n"] * b["d"], a["d"] * b["n"])
    }

    fn neg(a) {
        a = self.of(a)
        return {"n": -a["n"], "d": a["d"]}
    }

    fn recip(a) { return self.div(1, a) }

    fn powInt(a, k) {
        a = self.of(a)
        if k < 0 { return self.powInt(self.recip(a), -k) }
        let r = self.make(1, 1)
        for i in range(k) { r = self.mul(r, a) }
        return r
    }

    # -1, 0 or 1.
    fn compare(a, b) {
        a = self.of(a)
        b = self.of(b)
        let l = a["n"] * b["d"]
        let r = b["n"] * a["d"]
        if l < r { return -1 }
        if l > r { return 1 }
        return 0
    }

    fn equals(a, b) { return self.compare(a, b) == 0 }

    fn toNumber(a) {
        a = self.of(a)
        return a["n"] / a["d"]
    }

    fn isWhole(a) { return self.of(a)["d"] == 1 }

    # "3/4", "-2", "0".
    fn show(a) {
        a = self.of(a)
        if a["d"] == 1 { return str(a["n"]) }
        return str(a["n"]) + "/" + str(a["d"])
    }

    # "1 1/2" style.
    fn showMixed(a) {
        a = self.of(a)
        if a["d"] == 1 or abs(a["n"]) < a["d"] { return self.show(a) }
        let whole = a["n"] < 0 ? -floor(-a["n"] / a["d"]) : floor(a["n"] / a["d"])
        let rest = abs(a["n"]) % a["d"]
        return str(whole) + " " + str(rest) + "/" + str(a["d"])
    }

    # ── exact linear algebra ─────────────────────────────────────────────

    # Gauss-Jordan over fractions. Returns an array of fractions, or raises
    # when the system has no unique solution.
    fn solveSystem(a, b) {
        let n = len(a)
        let m = []
        for i in range(n) {
            let row = []
            for j in range(n) { row.push(self.of(a[i][j])) }
            row.push(self.of(b[i]))
            m.push(row)
        }
        for c in range(n) {
            let p = -1
            for r in range(c, n) {
                if m[r][c]["n"] != 0 {
                    p = r
                    break
                }
            }
            if p == -1 { raise "solveSystem: no unique solution" }
            let tmp = m[p]
            m[p] = m[c]
            m[c] = tmp
            let pivot = m[c][c]
            for k in range(c, n + 1) { m[c][k] = self.div(m[c][k], pivot) }
            for r in range(n) {
                if r != c and m[r][c]["n"] != 0 {
                    let f = m[r][c]
                    for k in range(c, n + 1) {
                        m[r][k] = self.sub(m[r][k], self.mul(f, m[c][k]))
                    }
                }
            }
        }
        let out = []
        for i in range(n) { out.push(m[i][n]) }
        return out
    }

    # Exact determinant.
    fn det(a) {
        let n = len(a)
        let m = []
        for i in range(n) {
            let row = []
            for j in range(n) { row.push(self.of(a[i][j])) }
            m.push(row)
        }
        let d = self.make(1, 1)
        for c in range(n) {
            let p = -1
            for r in range(c, n) {
                if m[r][c]["n"] != 0 {
                    p = r
                    break
                }
            }
            if p == -1 { return self.make(0, 1) }
            if p != c {
                let tmp = m[p]
                m[p] = m[c]
                m[c] = tmp
                d = self.neg(d)
            }
            d = self.mul(d, m[c][c])
            for r in range(c + 1, n) {
                let f = self.div(m[r][c], m[c][c])
                for k in range(c, n) {
                    m[r][k] = self.sub(m[r][k], self.mul(f, m[c][k]))
                }
            }
        }
        return d
    }

    fn showAll(list) { return list.map(fn(x) { return Frac.show(x) }) }
}

Frac = __Frac()
