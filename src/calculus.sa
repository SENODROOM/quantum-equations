# quantum-equations / calculus — derivatives, integrals, limits and ODEs
#
#   Calc.derivative(fn(x) { return x * x * x }, 2)       # 12
#   Calc.integrate(fn(x) { return sin(x) }, 0, PI)       # 2
#   Calc.rk4(fn(t, y) { return y }, 0, 1, 1, 100)        # {"t": [...], "y": [..., e]}
#
# Functions are ordinary Quantum functions. Multi-variable functions take
# an array: fn(v) { return v[0] * v[1] }.
# Exposes the global: Calc

# @use ./core.sa

class __Calc {
    fn init() {
        # 5-point Gauss-Legendre nodes and weights on [-1, 1]
        self.GL_X = [0, 0.5384693101056831, -0.5384693101056831, 0.9061798459386640, -0.9061798459386640]
        self.GL_W = [0.5688888888888889, 0.4786286704993665, 0.4786286704993665, 0.2369268850561891, 0.2369268850561891]
    }

    # ── derivatives ──────────────────────────────────────────────────────

    # f'(x), five-point central stencil (error ~ h^4).
    fn derivative(f, x, h) {
        if h == null { h = 1e-3 * max(1, abs(x)) }
        return (-f(x + 2 * h) + 8 * f(x + h) - 8 * f(x - h) + f(x - 2 * h)) / (12 * h)
    }

    # f''(x)
    fn derivative2(f, x, h) {
        if h == null { h = 1e-3 * max(1, abs(x)) }
        return (-f(x + 2 * h) + 16 * f(x + h) - 30 * f(x) + 16 * f(x - h) - f(x - 2 * h)) / (12 * h * h)
    }

    # Gradient of f(v) at the array point x.
    fn gradient(f, x, h) {
        let n = len(x)
        let g = []
        for i in range(n) {
            let hh = h == null ? 1e-4 * max(1, abs(x[i])) : h
            let xp = x.slice(0)
            let xm = x.slice(0)
            let xp2 = x.slice(0)
            let xm2 = x.slice(0)
            xp[i] = x[i] + hh
            xm[i] = x[i] - hh
            xp2[i] = x[i] + 2 * hh
            xm2[i] = x[i] - 2 * hh
            g.push((-f(xp2) + 8 * f(xp) - 8 * f(xm) + f(xm2)) / (12 * hh))
        }
        return g
    }

    # Jacobian matrix of an array of functions fs[i](v) at x.
    fn jacobian(fs, x) {
        let rows = []
        for fi in fs { rows.push(self.gradient(fi, x)) }
        return rows
    }

    # Hessian of f(v) at x (central differences).
    fn hessian(f, x) {
        let n = len(x)
        let hs = []
        for i in range(n) {
            let row = []
            for j in range(n) { row.push(0) }
            hs.push(row)
        }
        for i in range(n) {
            for j in range(i, n) {
                let hi = 1e-3 * max(1, abs(x[i]))
                let hj = 1e-3 * max(1, abs(x[j]))
                let a = x.slice(0)
                let b = x.slice(0)
                let c = x.slice(0)
                let d = x.slice(0)
                a[i] = a[i] + hi
                a[j] = a[j] + hj
                b[i] = b[i] + hi
                b[j] = b[j] - hj
                c[i] = c[i] - hi
                c[j] = c[j] + hj
                d[i] = d[i] - hi
                d[j] = d[j] - hj
                let v = (f(a) - f(b) - f(c) + f(d)) / (4 * hi * hj)
                hs[i][j] = v
                hs[j][i] = v
            }
        }
        return hs
    }

    # Derivative of tabulated data (central differences inside, one-sided at the ends).
    fn differentiate(xs, ys) {
        let n = len(xs)
        let out = []
        for i in range(n) {
            if i == 0 {
                out.push((ys[1] - ys[0]) / (xs[1] - xs[0]))
            } else if i == n - 1 {
                out.push((ys[i] - ys[i - 1]) / (xs[i] - xs[i - 1]))
            } else {
                out.push((ys[i + 1] - ys[i - 1]) / (xs[i + 1] - xs[i - 1]))
            }
        }
        return out
    }

    # ── limits ───────────────────────────────────────────────────────────

    # Two-sided limit of f at x0, or null when the sides disagree.
    # (The value at x0 itself is never used, so removable gaps are fine.)
    fn limit(f, x0) {
        let right = self.limitSide(f, x0, 1)
        let left = self.limitSide(f, x0, -1)
        if right == null or left == null { return null }
        if abs(right - left) > 1e-6 * max(1, abs(right)) { return null }
        return (right + left) / 2
    }

    fn limitSide(f, x0, dir) {
        let h = 1e-2
        let prev = f(x0 + dir * h)
        let best = prev
        for k in range(1, 9) {
            h = h / 10
            let cur = f(x0 + dir * h)
            if isNaN(cur) or abs(cur) >= INF { return null }
            best = cur
            if abs(cur - prev) < 1e-10 * max(1, abs(cur)) { break }
            prev = cur
        }
        if abs(best) > 1e8 { return null }
        return best
    }

    # ── integration ──────────────────────────────────────────────────────

    fn trapezoid(f, a, b, n) {
        if n == null { n = 1000 }
        let h = (b - a) / n
        let s = (f(a) + f(b)) / 2
        for i in range(1, n) { s = s + f(a + i * h) }
        return s * h
    }

    # Composite Simpson's rule (n is rounded up to an even number).
    fn simpson(f, a, b, n) {
        if n == null { n = 1000 }
        if n % 2 == 1 { n = n + 1 }
        let h = (b - a) / n
        let s = f(a) + f(b)
        for i in range(1, n) {
            s = s + f(a + i * h) * (i % 2 == 1 ? 4 : 2)
        }
        return s * h / 3
    }

    # Adaptive Simpson to the requested absolute tolerance.
    fn adaptive(f, a, b, tol) {
        if tol == null { tol = 1e-10 }
        let fa = f(a)
        let fb = f(b)
        let m = (a + b) / 2
        let fm = f(m)
        let whole = (b - a) / 6 * (fa + 4 * fm + fb)
        return self.adaptiveStep(f, a, b, fa, fm, fb, whole, tol, 40)
    }

    fn adaptiveStep(f, a, b, fa, fm, fb, whole, tol, depth) {
        let m = (a + b) / 2
        let lm = (a + m) / 2
        let rm = (m + b) / 2
        let flm = f(lm)
        let frm = f(rm)
        let left = (m - a) / 6 * (fa + 4 * flm + fm)
        let right = (b - m) / 6 * (fm + 4 * frm + fb)
        let delta = left + right - whole
        if depth <= 0 or abs(delta) <= 15 * tol {
            return left + right + delta / 15
        }
        return self.adaptiveStep(f, a, m, fa, flm, fm, left, tol / 2, depth - 1) + self.adaptiveStep(f, m, b, fm, frm, fb, right, tol / 2, depth - 1)
    }

    # Composite 5-point Gauss-Legendre (exact for polynomials up to degree 9 per panel).
    fn gauss(f, a, b, panels) {
        if panels == null { panels = 20 }
        let h = (b - a) / panels
        let total = 0
        for p in range(panels) {
            let lo = a + p * h
            let mid = lo + h / 2
            let s = 0
            for k in range(5) {
                s = s + self.GL_W[k] * f(mid + self.GL_X[k] * h / 2)
            }
            total = total + s * h / 2
        }
        return total
    }

    # Romberg integration (Richardson extrapolation of the trapezoid rule).
    fn romberg(f, a, b, levels) {
        if levels == null { levels = 12 }
        let prev = [(b - a) * (f(a) + f(b)) / 2]
        for k in range(1, levels) {
            let n = pow(2, k - 1)
            let h = (b - a) / pow(2, k)
            let s = 0
            for i in range(n) { s = s + f(a + (2 * i + 1) * h) }
            let cur = [prev[0] / 2 + h * s]
            for j in range(1, k + 1) {
                let f4 = pow(4, j)
                cur.push((f4 * cur[j - 1] - prev[j - 1]) / (f4 - 1))
            }
            if k > 3 and abs(cur[k] - prev[k - 1]) < 1e-13 * max(1, abs(cur[k])) { return cur[k] }
            prev = cur
        }
        return prev[len(prev) - 1]
    }

    # Best general-purpose integral over [a, b]; either end may be +-INF.
    fn integrate(f, a, b) {
        if a == b { return 0 }
        if a > b { return -self.integrate(f, b, a) }
        if a <= -INF and b >= INF {
            # x = t / (1 - t^2), t in (-1, 1)
            return self.gauss(fn(t) {
                let d = 1 - t * t
                return f(t / d) * (1 + t * t) / (d * d)
            }, -1, 1, 200)
        }
        if b >= INF {
            # x = a + t / (1 - t), t in [0, 1)
            return self.gauss(fn(t) {
                let d = 1 - t
                return f(a + t / d) / (d * d)
            }, 0, 1, 200)
        }
        if a <= -INF {
            # x = b - t / (1 - t)
            return self.gauss(fn(t) {
                let d = 1 - t
                return f(b - t / d) / (d * d)
            }, 0, 1, 200)
        }
        return self.adaptive(f, a, b, 1e-11)
    }

    # Area under tabulated data (trapezoid rule).
    fn trapz(xs, ys) {
        let s = 0
        for i in range(1, len(xs)) {
            s = s + (xs[i] - xs[i - 1]) * (ys[i] + ys[i - 1]) / 2
        }
        return s
    }

    # Double integral of f(x, y) over a rectangle (composite Simpson, n x n).
    fn integrate2(f, ax, bx, ay, by, n) {
        if n == null { n = 60 }
        if n % 2 == 1 { n = n + 1 }
        let hx = (bx - ax) / n
        let hy = (by - ay) / n
        let total = 0
        for i in range(n + 1) {
            let wx = (i == 0 or i == n) ? 1 : (i % 2 == 1 ? 4 : 2)
            let x = ax + i * hx
            for j in range(n + 1) {
                let wy = (j == 0 or j == n) ? 1 : (j % 2 == 1 ? 4 : 2)
                total = total + wx * wy * f(x, ay + j * hy)
            }
        }
        return total * hx * hy / 9
    }

    # Length of the curve y = f(x) on [a, b].
    fn arcLength(f, a, b) {
        let me = self
        return self.integrate(fn(x) {
            let d = me.derivative(f, x)
            return sqrt(1 + d * d)
        }, a, b)
    }

    # ── series & sums ────────────────────────────────────────────────────

    # Sum of term(k) for k = from..to inclusive.
    fn sumSeries(term, first, last) {
        let s = 0
        for k in range(first, last + 1) { s = s + term(k) }
        return s
    }

    fn productSeries(term, first, last) {
        let p = 1
        for k in range(first, last + 1) { p = p * term(k) }
        return p
    }

    # Taylor-polynomial value of f around a, of order n, evaluated at x
    # (derivatives estimated numerically, so keep n small: <= 6).
    fn taylor(f, a, n, x) {
        let total = f(a)
        let coeffs = [f(a)]
        let h = 0.05
        let cur = []
        let ys = []
        for k in range(-n, n + 1) { ys.push(f(a + k * h)) }
        # repeated central differences
        let level = ys.slice(0)
        let fact = 1
        for order in range(1, n + 1) {
            let next = []
            for i in range(1, len(level) - 1) {
                next.push(level[i + 1] - level[i - 1])
            }
            # each pass differentiates once with step 2h
            let scaled = next.map(fn(v) { return v / (2 * h) })
            level = scaled
            let mid = floor(len(level) / 2)
            fact = fact * order
            total = total + level[mid] / fact * pow(x - a, order)
        }
        return total
    }

    # ── differential equations ───────────────────────────────────────────

    # Forward Euler for y' = f(t, y). y may be a number or an array (system).
    # Returns {"t": [...], "y": [...]} with steps + 1 samples.
    fn euler(f, t0, y0, tEnd, steps) {
        let h = (tEnd - t0) / steps
        let ts = [t0]
        let ys = [y0]
        let t = t0
        let y = y0
        for i in range(steps) {
            y = self.vadd(y, self.vscale(f(t, y), h))
            t = t0 + (i + 1) * h
            ts.push(t)
            ys.push(y)
        }
        return {"t": ts, "y": ys}
    }

    # Classic 4th-order Runge-Kutta.
    fn rk4(f, t0, y0, tEnd, steps) {
        let h = (tEnd - t0) / steps
        let ts = [t0]
        let ys = [y0]
        let t = t0
        let y = y0
        for i in range(steps) {
            let k1 = f(t, y)
            let k2 = f(t + h / 2, self.vadd(y, self.vscale(k1, h / 2)))
            let k3 = f(t + h / 2, self.vadd(y, self.vscale(k2, h / 2)))
            let k4 = f(t + h, self.vadd(y, self.vscale(k3, h)))
            let incr = self.vadd(self.vadd(k1, self.vscale(k2, 2)), self.vadd(self.vscale(k3, 2), k4))
            y = self.vadd(y, self.vscale(incr, h / 6))
            t = t0 + (i + 1) * h
            ts.push(t)
            ys.push(y)
        }
        return {"t": ts, "y": ys}
    }

    # Final value of y at tEnd (RK4 with 1000 steps unless given).
    fn solveIVP(f, t0, y0, tEnd, steps) {
        if steps == null { steps = 1000 }
        let r = self.rk4(f, t0, y0, tEnd, steps)
        return r["y"][len(r["y"]) - 1]
    }

    # Number-or-array helpers used by the ODE solvers.
    fn vadd(a, b) {
        if type(a) != "array" { return a + b }
        let out = []
        for i in range(len(a)) { out.push(a[i] + b[i]) }
        return out
    }

    fn vscale(a, k) {
        if type(a) != "array" { return a * k }
        let out = []
        for i in range(len(a)) { out.push(a[i] * k) }
        return out
    }
}

Calc = __Calc()
